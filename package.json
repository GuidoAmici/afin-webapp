{
  "name": "afin-webapp",
  "version": "1.3.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.13.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "db:types": "node scripts/supabase-guard.mjs && node scripts/db-types.mjs",
    "db:types:check": "node scripts/supabase-guard.mjs && node scripts/db-types.mjs --check",
    "db:types:remote": "supabase gen types typescript --project-id wbsvxdquzvsawmjoiwat --schema public > lib/database.types.ts",
    "db:guard": "node scripts/supabase-guard.mjs status",
    "db:guard:release": "node scripts/supabase-guard.mjs release"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "mercadopago": "^3.1.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.7",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  }
}
