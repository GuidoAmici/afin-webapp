# Plantilla de variables de entorno. Copiar a `.env.local` (gitignored) y completar.
# Las NEXT_PUBLIC_* se exponen al browser; el resto son server-only.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Clientes públicos (browser + server con sesión de usuario).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service client (server-only, privilegios elevados: webhook MP + jobs de sistema).
# Es una variable Sensitive en Vercel y NO se puede scopear al environment
# Development → para dev local va acá, en tu .env.local. Usar el sb_secret_ de la
# DB de test, nunca el de prod.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Brevo (email) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_LIST_ID=

# ── CallMeBot (notificaciones) ────────────────────────────────────────────────
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feature flags (ver docs/adr/0005 y lib/flags.ts) ──────────────────────────
# Valores aceptados: 1/true/on · 0/false/off. Vacío = default del código.
# Se inlinean en el build: cambiarlas exige redeploy del entorno.

# Canal de pedidos por el sitio (carrito, /api/orders, /cuenta/pedidos).
# Default del código: on. Apagado, el catálogo deriva a WhatsApp.
NEXT_PUBLIC_FF_PEDIDOS=true

# Pago online con Mercado Pago (botón de pago + /api/checkout/mp).
# Default del código: off — pendiente de credenciales de producción (#25).
# El webhook de MP no depende de este flag.
NEXT_PUBLIC_FF_CHECKOUT_MP=false

# Secciones del panel /empleados que todavía no existen (#18).
# Prender recién cuando la pantalla esté, o el nav linkea a un 404.
NEXT_PUBLIC_FF_PANEL_PRODUCTOS=false
NEXT_PUBLIC_FF_PANEL_CLIENTES=false

# Los ops flags (payments_enabled, transfer_enabled, order_expiry_enabled) NO son
# env vars: viven en la tabla `settings` y los mueve un admin sin deploy.
# Ver lib/settings.ts.
