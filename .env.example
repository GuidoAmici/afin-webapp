# Plantilla de variables de entorno. Copiar a `.env.local` (gitignored) y completar.
# Las NEXT_PUBLIC_* se exponen al browser; el resto son server-only.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Clientes públicos (browser + server con sesión de usuario).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service client (server-only, privilegios elevados: webhook MP + jobs de sistema).
# Es una variable Sensitive en Vercel y NO se puede scopear al environment
# Development → para dev local va acá, en tu .env.local. Usar el sb_secret_ de la
# DB de test, nunca el de prod.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Brevo (email) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_LIST_ID=

# ── CallMeBot (notificaciones) ────────────────────────────────────────────────
# Van de a pares: la API key de CallMeBot está atada al número, mezclarlos no
# notifica a nadie. Se configuran por entorno en Vercel:
#   staging:    CALLMEBOT_PHONE=5491140230984
#   production: CALLMEBOT_PHONE=5491149353395
# Sin CALLMEBOT_PHONE no se envía nada (no hay número por defecto, a propósito:
# un entorno mal configurado no debe mandarle pedidos de prueba a un teléfono real).
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feature flag de pedidos (ver docs/adr/0005, docs/adr/0006 y lib/pedidos-flag.ts) ──
# Valores aceptados: 1/true/on · 0/false/off. Vacío = default del código.
# Se inlinea en el build: cambiarla exige redeploy del entorno. Sigue siendo env var
# (a diferencia de los otros flags de release, ver abajo) porque vive en el Header,
# presente en todas las páginas — evaluarla en runtime le haría perder ISR al sitio.

# Canal de pedidos por el sitio (carrito, /api/orders, /cuenta/pedidos).
# Default del código: on. Apagado, el catálogo deriva a WhatsApp.
NEXT_PUBLIC_FF_PEDIDOS=true

# ── Flags de release por SDK (ver docs/adr/0006 y lib/flags.ts) ────────────────
# checkoutMp, panelProductos y panelClientes viven en Vercel Flags SDK, no en env
# vars: se togglean desde el dashboard de Vercel (Project → Flags) sin redeploy.
# FLAGS_SECRET autentica el discovery endpoint (app/.well-known/vercel/flags) que
# expone esos flags a Flags Explorer — un valor distinto por entorno, generado con:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
FLAGS_SECRET=

# ── Ops flags ───────────────────────────────────────────────────────────────────
# payments_enabled, transfer_enabled, order_expiry_enabled NO son env vars ni
# flags del SDK: viven en la tabla `settings` y los mueve un admin sin deploy.
# Ver lib/settings.ts.
