# Config de auth del stack LOCAL.
#
# Hay que cargarlo ANTES de `supabase start`, o GoTrue toma el literal
# "env(SUPABASE_AUTH_SITE_URL)" como site_url y {{ .SiteURL }} sale sin
# resolver en los mails.
#
#   set -a; . supabase/env/local.env; set +a
#   supabase start
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://127.0.0.1:3000/**
