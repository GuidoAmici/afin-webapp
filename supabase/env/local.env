# Config de auth del stack LOCAL.
#
# Hay que cargarlo ANTES de cualquier comando `supabase`: config.toml lee
# estas variables con env(). Sin SUPABASE_AUTH_ENABLE_SIGNUP el CLI no parsea
# el archivo; sin SUPABASE_AUTH_SITE_URL GoTrue toma el literal
# "env(SUPABASE_AUTH_SITE_URL)" como site_url y {{ .SiteURL }} sale sin
# resolver en los mails.
#
#   npm run db:start:local      # carga este archivo y corre `supabase start`
#
# (db:types y db:types:check también lo cargan.) A mano:
#
#   set -a; . supabase/env/local.env; set +a
#   supabase start
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://127.0.0.1:3000/**
SUPABASE_AUTH_ENABLE_SIGNUP=true
